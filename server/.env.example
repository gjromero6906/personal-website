# Local Postgres connection — pg reads these automatically (no config needed in pool.js)
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Replace with your own random string — used to sign session cookies
SESSION_SECRET=

# When deploying, set this to your hosted database URL instead of the vars above
PG_CONNECTION_STRING=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=